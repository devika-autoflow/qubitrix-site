# n8n webhook that powers the chat console (receives every chat message + session ids)
VITE_CHAT_WEBHOOK_URL=https://n8n.devikarajnr.fyi/webhook/qubitrix-chatbot

# n8n webhook for the real-estate lead-qualification demo (outreach /demo page)
